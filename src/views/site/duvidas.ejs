<!DOCTYPE html>
<html lang="pt-BR">
<head>
<%- include('../partials/head') %>
</head>
<body>
<%- include('../partials/header') %>

<main id="conteudo-principal" class="container">
    <h1>Dúvidas</h1>
    <p>Envie sua dúvida de forma totalmente anônima — não coletamos nome, e-mail ou qualquer outro dado seu.</p>

    <% if (enviado) { %>
        <p class="sucesso">Dúvida enviada com sucesso! Ela passará por moderação antes de virar uma resposta pública.</p>
    <% } %>

    <% if (erro) { %>
        <p class="erros" role="alert"><%= erro %></p>
    <% } %>

    <form method="POST" action="/duvidas" class="formulario">
        <div class="campo">
            <label for="pergunta">Sua dúvida</label>
            <textarea id="pergunta" name="pergunta" rows="4" required maxlength="1000"></textarea>
        </div>
        <button type="submit" class="botao-primario">Enviar</button>
    </form>

    <section aria-labelledby="titulo-faq">
        <h2 id="titulo-faq">Perguntas frequentes</h2>
        <% if (faq.length === 0) { %>
            <p class="estado-vazio">Nenhuma pergunta respondida publicada ainda.</p>
        <% } else { %>
            <ul class="cards">
                <% faq.forEach(function(item) { %>
                    <li>
                        <p class="cards__titulo"><%= item.pergunta %></p>
                        <p><%= item.resposta %></p>
                    </li>
                <% }); %>
            </ul>
        <% } %>
    </section>
</main>

<%- include('../partials/footer') %>
<script src="/js/acessibilidade.js"></script>
</body>
</html>
