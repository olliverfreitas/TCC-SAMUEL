<!DOCTYPE html>
<html lang="pt-BR">
<head>
<%- include('../partials/head') %>
</head>
<body>
<%- include('../partials/header') %>

<main class="container">
    <h1>Resultado</h1>
    <p>Voce acertou <%= resultado.acertos %> de <%= resultado.total %> perguntas.</p>

    <ul class="cards">
        <% resultado.resultado.forEach(function(item) { %>
            <li class="<%= item.acertou ? 'acertou' : 'errou' %>">
                <p><%= item.enunciado %></p>
                <p><%= item.acertou ? 'Voce acertou!' : 'Resposta correta: ' + item.opcaoCorreta %></p>
                <% if (item.explicacao) { %>
                    <p class="explicacao"><%= item.explicacao %></p>
                <% } %>
            </li>
        <% }); %>
    </ul>

    <a href="/quiz">Refazer o quiz</a>
</main>

<%- include('../partials/footer') %>
</body>
</html>
