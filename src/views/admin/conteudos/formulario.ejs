<!DOCTYPE html>
<html lang="pt-BR">
<head>
<%- include('../../partials/head') %>
</head>
<body>
<%- include('../../partials/admin-header') %>

<main id="conteudo-principal" class="container">
    <h1><%= conteudo && conteudo.id ? 'Editar conteúdo' : 'Novo conteúdo' %></h1>

    <% if (erros.length > 0) { %>
        <ul class="erros" role="alert">
            <% erros.forEach(function(erro) { %>
                <li><%= erro.msg %></li>
            <% }); %>
        </ul>
    <% } %>

    <form
        method="POST"
        action="<%= conteudo && conteudo.id ? `/admin/conteudos/${conteudo.id}/editar` : '/admin/conteudos/novo' %>"
        class="formulario"
    >
        <div class="campo">
            <label for="categoriaId">Categoria</label>
            <select id="categoriaId" name="categoriaId" required>
                <option value="">Selecione</option>
                <% categorias.forEach(function(categoria) { %>
                    <option value="<%= categoria.id %>" <%= conteudo && Number(conteudo.categoria_id) === categoria.id ? 'selected' : '' %>>
                        <%= categoria.nome %>
                    </option>
                <% }); %>
            </select>
        </div>

        <div class="campo">
            <label for="titulo">Título</label>
            <input type="text" id="titulo" name="titulo" value="<%= conteudo ? conteudo.titulo : '' %>" required maxlength="200">
        </div>

        <div class="campo">
            <label for="resumo">Resumo</label>
            <input type="text" id="resumo" name="resumo" value="<%= conteudo ? conteudo.resumo : '' %>" required maxlength="300">
        </div>

        <div class="campo">
            <label for="corpoHtml">Conteúdo</label>
            <textarea id="corpoHtml" name="corpoHtml" rows="10" required><%= conteudo ? conteudo.corpo_html : '' %></textarea>
        </div>

        <div class="campo">
            <label for="fontes">Fontes</label>
            <input type="text" id="fontes" name="fontes" value="<%= conteudo ? conteudo.fontes : '' %>" required placeholder="Ex.: Ministério da Saúde; OMS/OPAS">
        </div>

        <div class="campo">
            <label for="faixaEtaria">Faixa etária</label>
            <select id="faixaEtaria" name="faixaEtaria" required>
                <option value="adolescente" <%= conteudo && conteudo.faixa_etaria === 'adolescente' ? 'selected' : '' %>>Adolescente</option>
                <option value="adulto" <%= conteudo && conteudo.faixa_etaria === 'adulto' ? 'selected' : '' %>>Adulto</option>
                <option value="todas" <%= !conteudo || conteudo.faixa_etaria === 'todas' ? 'selected' : '' %>>Todas as idades</option>
            </select>
        </div>

        <div class="campo campo--checkbox">
            <label>
                <input type="checkbox" name="publicado" <%= !conteudo || conteudo.publicado ? 'checked' : '' %>>
                Publicado (desmarque para salvar como rascunho)
            </label>
        </div>

        <button type="submit" class="botao-primario">Salvar</button>
    </form>
</main>
<%- include('../../partials/footer') %>
<script src="/js/acessibilidade.js"></script>
</body>
</html>
