<!DOCTYPE html>
<html lang="pt-BR">
<head>
<%- include('../partials/head') %>
</head>
<body>
<%- include('../partials/admin-header') %>

<main class="container">
    <h1>Duvidas</h1>

    <h2>Pendentes</h2>
    <ul class="cards">
        <% pendentes.forEach(function(duvida) { %>
            <li>
                <p><%= duvida.pergunta %></p>
                <form method="POST" action="/admin/duvidas/<%= duvida.id %>/responder">
                    <textarea name="resposta" rows="3" required placeholder="Digite a resposta"></textarea>
                    <button type="submit">Responder</button>
                </form>
            </li>
        <% }); %>
        <% if (pendentes.length === 0) { %>
            <li>Nenhuma duvida pendente.</li>
        <% } %>
    </ul>

    <h2>Respondidas</h2>
    <ul class="cards">
        <% respondidas.forEach(function(duvida) { %>
            <li>
                <p><strong>Pergunta:</strong> <%= duvida.pergunta %></p>
                <p><strong>Resposta:</strong> <%= duvida.resposta %></p>
            </li>
        <% }); %>
    </ul>
</main>
</body>
</html>
